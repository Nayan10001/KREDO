{
    "manifest_version": 3,
    "name": "KREDO",
    "version": "1.0.0",
    "description": "AI-Powered Misinformation Detection — Quick fake/real verdict while browsing.",
    "permissions": [
        "activeTab",
        "storage",
        "sidePanel",
        "tabs"
    ],
    "host_permissions": [
        "http://localhost:8000/*"
    ],
    "action": {},
    "side_panel": {
        "default_path": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}